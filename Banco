
create database Agenda_SCA;
use Agenda_SCA;

create table local_Eventos (

idlocal int AUTO_INCREMENT PRIMARY KEY,
	numero int,
	capacidade_pessoa int,
	endereco varchar(200),
	cidade varchar (100),
	estado varchar (100),
	nome_local varchar (200),
	capacidade_carros int

);
 create table usuario(
	
    idUsuario int AUTO_INCREMENT primary key,
    nome varchar(200),
    email varchar (100),
    senha varchar (100)
 
 );
 
 create table tipo_evento(
	
    idtipo_evento int AUTO_INCREMENT primary key,
    tipo varchar (100)
 
 );
 
 create table frequencia (
	
    idfrequencia int AUTO_INCREMENT primary key,
    descricao ENUM('Diaria','Semanal','Mensal','Bimestral', 'Anual') NOT NULL

 );

create table Registro_login (

	idRegistro int AUTO_INCREMENT primary key,
    data_login DATETIME DEFAULT CURRENT_TIMESTAMP,
    ip_acesso varchar(45),
    idUsuario int,
    constraint foreign key (idUsuario) references usuario (idUsuario) on DELETE CASCADE ON UPDATE CASCADE

);

create table Eventos (

	idEventos int AUTO_INCREMENT primary key,
    nome varchar(200),
    descricao varchar (200),
    preco decimal (10,2) Null,
    idUsuario int,
    idlocal int,
    idtipo_evento int,
    idfrequencia int,
	constraint foreign key (idUsuario) references usuario (idUsuario) on DELETE CASCADE ON UPDATE CASCADE,
	constraint foreign key (idlocal) references Local_Eventos (idlocal) on DELETE CASCADE ON UPDATE CASCADE,
	constraint foreign key (idtipo_evento) references tipo_evento (idtipo_evento) on DELETE CASCADE ON UPDATE CASCADE,
    constraint foreign key (idfrequencia) references frequencia (idfrequencia) on DELETE CASCADE ON UPDATE CASCADE

);

create table Agenda(

	idAgenda int AUTO_INCREMENT primary key,
    data date,
    hora time,
    idEventos int,
    constraint foreign key (idEventos) references Eventos (idEventos) on DELETE CASCADE ON UPDATE CASCADE

);

